# =============================================================================
# LRIMa Website - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# MongoDB connection string. Use a secure, authenticated connection in production.
# Local development: mongodb://127.0.0.1:27017/lrima-website
# Production: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
DATABASE_URI=mongodb://127.0.0.1:27017/lrima-website
MONGODB_URI=mongodb://127.0.0.1:27017/lrima-website

# -----------------------------------------------------------------------------
# Payload CMS Configuration
# -----------------------------------------------------------------------------
# Secret key for Payload CMS authentication and encryption.
# IMPORTANT: Generate a secure 64+ character random string for production:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
PAYLOAD_SECRET=your-secret-key-here-change-in-production

# -----------------------------------------------------------------------------
# Site Configuration
# -----------------------------------------------------------------------------
# Public URL of the site. Used for canonical URLs, OG tags, sitemaps, etc.
# Local: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Resend (Email) Configuration
# -----------------------------------------------------------------------------
# API key from https://resend.com/api-keys
# Required for the contact form to send emails
RESEND_API_KEY=re_your_api_key_here

# Email address used as the sender ("From" field)
# This domain must be verified in Resend dashboard
# Format: Display Name <email@domain.com>
RESEND_FROM_EMAIL=LRIMa <contact@lrima.ca>

# -----------------------------------------------------------------------------
# Vercel Blob Storage (Optional)
# -----------------------------------------------------------------------------
# Only needed if using Vercel Blob for media storage
# Get these from your Vercel project settings > Storage
BLOB_READ_WRITE_TOKEN=vercel_blob_your_token_here
